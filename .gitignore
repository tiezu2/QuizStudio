# 构建与运行产物
__pycache__/
*.pyc
_build/
desktop/build/
desktop/dist/

# 本地配置（含 API Key，不提交）
quiz_studio_llm.json
desktop/quiz_studio_llm.json
desktop/quiz_studio_ide.json
_opened_code.json

# 导出与归档（可重新生成）
_export/
_archive/
*.zip
*.bak
*.bak-*

# 桌面版二进制（用脚本重新打）
desktop/release/*.exe

# 开发过程中的临时文件（脚本、日志、预览图）
_dev/_*
_dev/*.log
_dev/preview_*/
_dev/*.docx
_import/*.log

# 素材（体积大，且是教材照片）
新大题/

# 编辑器
.vscode/
.idea/

# SQLite 运行时文件
*.db-shm
*.db-wal
